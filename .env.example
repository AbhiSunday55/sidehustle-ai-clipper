# Optional: required only for AI video analysis and caption generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Together AI key for sampled-frame captioning and scoring.
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen3.5-9B

# Required only for Instagram publishing. Use an Instagram professional account
# connected to a Facebook Page and credentials with the required publishing permissions.
IG_ACCESS_TOKEN=
IG_USER_ID=

# Set this to a Graph API version currently supported by your Meta app (for example vNN.0).
META_GRAPH_API_VERSION=
